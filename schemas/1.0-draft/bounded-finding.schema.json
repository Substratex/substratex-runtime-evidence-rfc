{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:substratex:res:1.0:schema:bounded-finding",
  "title": "RES Bounded Finding",
  "allOf": [
    {
      "$ref": "urn:substratex:res:1.0:schema:common#/$defs/baseEnvelope"
    },
    {
      "type": "object",
      "required": [
        "object_type",
        "evidence_record_id",
        "evidence_dependencies",
        "method_id",
        "method_version",
        "support_class",
        "scope",
        "status",
        "claim_boundary_ref",
        "review_state"
      ],
      "properties": {
        "object_type": {
          "const": "bounded_finding"
        },
        "evidence_record_id": {
          "type": "string"
        },
        "evidence_dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "method_id": {
          "type": "string"
        },
        "method_version": {
          "type": "string"
        },
        "support_class": {
          "$ref": "urn:substratex:res:1.0:schema:common#/$defs/supportClass"
        },
        "scope": {
          "$ref": "urn:substratex:res:1.0:schema:common#/$defs/scope"
        },
        "status": {
          "type": "string"
        },
        "claim_boundary_ref": {
          "type": "string"
        },
        "missingness": {
          "type": "array",
          "items": {
            "$ref": "urn:substratex:res:1.0:schema:common#/$defs/missingness"
          }
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": true
        },
        "review_state": {
          "$ref": "urn:substratex:res:1.0:schema:common#/$defs/reviewState"
        }
      }
    }
  ]
}