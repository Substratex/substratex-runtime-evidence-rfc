{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:substratex:res:1.0:schema:canonical-runtime",
  "title": "RES Canonical Runtime",
  "allOf": [
    {
      "$ref": "urn:substratex:res:1.0:schema:common#/$defs/baseEnvelope"
    },
    {
      "type": "object",
      "required": [
        "object_type",
        "source_ids",
        "canonicalization_contract",
        "ordering",
        "events"
      ],
      "properties": {
        "object_type": {
          "const": "canonical_runtime"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "canonicalization_contract": {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "ordering": {
          "type": "object",
          "required": [
            "canonical_semantics"
          ],
          "properties": {
            "source_semantics": {
              "type": "string"
            },
            "canonical_semantics": {
              "type": "string"
            },
            "conflict_state": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "temporal_coordinate_systems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event_id",
              "event_type",
              "order_index",
              "source_refs"
            ],
            "properties": {
              "event_id": {
                "type": "string"
              },
              "event_type": {
                "type": "string"
              },
              "order_index": {
                "type": [
                  "integer",
                  "number",
                  "string"
                ]
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "role_ref": {
                "type": "string"
              },
              "payload": {},
              "payload_ref": {
                "type": "string"
              },
              "temporal_coordinates": {
                "type": "object",
                "additionalProperties": true
              },
              "missingness": {
                "type": "array",
                "items": {
                  "$ref": "urn:substratex:res:1.0:schema:common#/$defs/missingness"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "canonical_digest": {
          "$ref": "urn:substratex:res:1.0:schema:common#/$defs/integrityRef"
        },
        "declared_exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  ]
}