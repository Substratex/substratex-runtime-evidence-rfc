{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:substratex:res:1.0:schema:certified-runtime-evidence-record",
  "title": "RES Certified Runtime Evidence Record",
  "allOf": [
    {
      "$ref": "urn:substratex:res:1.0:schema:common#/$defs/baseEnvelope"
    },
    {
      "type": "object",
      "required": [
        "object_type",
        "run_id",
        "canonical_runtime_id",
        "source_ids",
        "evidence_inventory",
        "governing_versions",
        "issuance"
      ],
      "properties": {
        "object_type": {
          "const": "certified_runtime_evidence_record"
        },
        "run_id": {
          "type": "string"
        },
        "canonical_runtime_id": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_inventory": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bounded_finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "governing_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "missingness": {
          "type": "array",
          "items": {
            "$ref": "urn:substratex:res:1.0:schema:common#/$defs/missingness"
          }
        },
        "integrity_references": {
          "type": "array",
          "items": {
            "$ref": "urn:substratex:res:1.0:schema:common#/$defs/integrityRef"
          }
        },
        "review_state": {
          "$ref": "urn:substratex:res:1.0:schema:common#/$defs/reviewState"
        },
        "issuance": {
          "type": "object",
          "required": [
            "profile",
            "result",
            "non_certifications"
          ],
          "properties": {
            "profile": {
              "type": "string"
            },
            "result": {
              "const": "issued"
            },
            "conformance_report_ref": {
              "type": "string"
            },
            "non_certifications": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}