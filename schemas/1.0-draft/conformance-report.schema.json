{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:substratex:res:1.0:schema:conformance-report",
  "title": "RES Conformance Report",
  "type": "object",
  "required": [
    "res_version",
    "implementation",
    "profile",
    "result",
    "dimensions",
    "tests"
  ],
  "properties": {
    "res_version": {
      "const": "1.0-draft"
    },
    "implementation": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "independent_of_reference": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "profile": {
      "enum": [
        "RES-Core",
        "RES-Formation",
        "RES-Finding",
        "RES-Issuance",
        "RES-Preservation",
        "RES-Full"
      ]
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "partial"
      ]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "pass",
          "fail",
          "not_tested",
          "not_applicable"
        ]
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_tested",
              "not_applicable"
            ]
          },
          "details": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}