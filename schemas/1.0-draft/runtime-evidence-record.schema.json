{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:substratex:res:1.0:schema:runtime-evidence-record",
  "title": "RES Runtime Evidence Record",
  "allOf": [
    {
      "$ref": "urn:substratex:res:1.0:schema:common#/$defs/baseEnvelope"
    },
    {
      "type": "object",
      "required": [
        "object_type",
        "run_id",
        "canonical_runtime_id",
        "source_ids",
        "evidence_inventory",
        "governing_versions"
      ],
      "properties": {
        "object_type": {
          "const": "runtime_evidence_record"
        },
        "run_id": {
          "type": "string"
        },
        "canonical_runtime_id": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_inventory": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bounded_finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "governing_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "missingness": {
          "type": "array",
          "items": {
            "$ref": "urn:substratex:res:1.0:schema:common#/$defs/missingness"
          }
        },
        "integrity_references": {
          "type": "array",
          "items": {
            "$ref": "urn:substratex:res:1.0:schema:common#/$defs/integrityRef"
          }
        },
        "review_state": {
          "$ref": "urn:substratex:res:1.0:schema:common#/$defs/reviewState"
        }
      }
    }
  ]
}